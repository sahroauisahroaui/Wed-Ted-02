$(document).ready(function() {
    $('#gpaForm').submit(function(e) {
        e.preventDefault();
        $.ajax({
            url: 'calculate.php',
            type: 'POST',
            data: $(this).serialize(),
            dataType: 'json',
            success: function(response) {
                if(response.success) {
                    $('#result').html('<div class="alert alert-info">' + response.message + '</div>' + response.tableHtml);
                }
            }
        });
    });
});
